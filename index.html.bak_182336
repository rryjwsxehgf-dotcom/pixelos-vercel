<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>PixelOS Desktop</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <style>
        body { display: flex; flex-direction: column; }
        .desktop { flex: 1; display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); grid-template-rows: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; padding: 20px; padding-bottom: 70px; align-content: start; overflow-y: auto; position: relative; z-index: 1; }
        .desktop-icon { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; cursor: pointer; padding: 14px 10px; border-radius: 4px; transition: all 0.2s; min-height: 100px; border: 1px solid transparent; }
        .desktop-icon:hover { background: rgba(180, 77, 255, 0.06); border-color: rgba(180, 77, 255, 0.2); }
        .desktop-icon:active { transform: scale(0.9); background: rgba(180, 77, 255, 0.12); }
        .icon-img { width: 52px; height: 52px; clip-path: polygon(20% 0%, 80% 0%, 100% 30%, 100% 70%, 80% 100%, 20% 100%, 0% 70%, 0% 30%); display: flex; align-items: center; justify-content: center; font-size: 26px; border: 1px solid var(--border-glow); }
        .icon-paint { background: linear-gradient(135deg, #ff6b6b, #ee5a24); }
        .icon-video { background: linear-gradient(135deg, var(--neon-purple), var(--neon-blue)); }
        .icon-gallery { background: linear-gradient(135deg, #00b894, var(--neon-cyan)); }
        .icon-google { background: linear-gradient(135deg, #4285f4, #34a853); }
        .icon-erik { background: linear-gradient(135deg, #636e72, var(--neon-green)); }
        .icon-admin { background: linear-gradient(135deg, #2d3436, var(--text-dim)); }
        .icon-label { font-family: var(--font-mono); font-size: 10px; color: var(--text-secondary); text-align: center; letter-spacing: 0.5px; }
        .window { position: fixed; background: rgba(12, 12, 32, 0.8); backdrop-filter: blur(30px); border: 1px solid var(--border-glow); box-shadow: 0 8px 32px rgba(0,0,0,0.6); display: flex; flex-direction: column; min-width: 300px; min-height: 220px; z-index: 100; overflow: hidden; clip-path: polygon(0% 0%, 100% 0%, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0% 100%); animation: winOpen 0.3s ease; transition: all 0.3s ease; }
        .window.maximized { left: 0 !important; top: 0 !important; width: 100vw !important; height: 100vh !important; clip-path: none; }
        .window.minimized { opacity: 0; pointer-events: none; transform: translateY(80px) scale(0.8); }
        @keyframes winOpen { from { opacity: 0; transform: scale(0.9) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }
        .window-titlebar { height: 38px; background: rgba(8, 8, 24, 0.9); display: flex; align-items: center; padding: 0 10px; cursor: grab; border-bottom: 1px solid var(--border-glow); flex-shrink: 0; touch-action: none; gap: 8px; }
        .win-controls { display: flex; gap: 6px; }
        .win-btn { width: 12px; height: 12px; clip-path: polygon(20% 0%, 80% 0%, 100% 50%, 80% 100%, 20% 100%, 0% 50%); cursor: pointer; transition: all 0.2s; }
        .btn-close { background: var(--neon-red); } .btn-min { background: var(--neon-yellow); } .btn-max { background: var(--neon-green); }
        .window-title { flex: 1; text-align: center; font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 1px; color: var(--text-primary); pointer-events: none; }
        .window-body { flex: 1; overflow: auto; position: relative; }
        .window-body iframe { width: 100%; height: 100%; border: none; }
        .taskbar { position: fixed; bottom: 0; left: 0; right: 0; height: 50px; background: rgba(8, 8, 24, 0.9); backdrop-filter: blur(20px); border-top: 1px solid var(--border-glow); display: flex; align-items: center; padding: 0 10px; gap: 6px; z-index: 10000; overflow-x: auto; }
        .taskbar.hidden { display: none; }
        .taskbar-item { padding: 6px 12px; border: 1px solid transparent; clip-path: polygon(4px 0%, 100% 0%, calc(100% - 4px) 100%, 0% 100%); font-family: var(--font-mono); font-size: 10px; cursor: pointer; white-space: nowrap; flex-shrink: 0; display: flex; align-items: center; gap: 5px; color: var(--text-secondary); transition: all 0.2s; }
        .taskbar-item.active { background: rgba(180, 77, 255, 0.2); border-color: var(--neon-purple); color: #fff; }
        .gallery-delete-btn { position: absolute; top: 4px; right: 4px; width: 22px; height: 22px; background: rgba(255, 50, 50, 0.85); color: #fff; border: none; cursor: pointer; font-size: 13px; font-weight: bold; display: flex; align-items: center; justify-content: center; z-index: 10; }
        .gallery-delete-btn:hover { background: rgba(255, 0, 0, 1); }
        .toast { position: fixed; bottom: 70px; left: 50%; transform: translateX(-50%); background: rgba(8,8,24,0.95); border: 1px solid var(--neon-purple); color: var(--text-primary); padding: 10px 20px; font-family: var(--font-mono); font-size: 11px; z-index: 99999; animation: toastIn 0.3s ease; pointer-events: none; }
        @keyframes toastIn { from { opacity: 0; transform: translateX(-50%) translateY(20px); } to { opacity: 1; transform: translateX(-50%) translateY(0); } }
    </style>
</head>
<body>

    <div class="crt-overlay"></div>
    <div class="crt-vignette"></div>

    <div class="desktop" id="desktop">
        <div class="desktop-icon" ondblclick="openApp('paint')" ontouchend="handleTouch(event,'paint')"><div class="icon-img icon-paint">🎨</div><span class="icon-label">Paint</span></div>
        <div class="desktop-icon" ondblclick="openApp('video')" ontouchend="handleTouch(event,'video')"><div class="icon-img icon-video">🎬</div><span class="icon-label">Video</span></div>
        <div class="desktop-icon" ondblclick="openApp('gallery')" ontouchend="handleTouch(event,'gallery')"><div class="icon-img icon-gallery">🖼️</div><span class="icon-label">Gallery</span></div>
        <div class="desktop-icon" ondblclick="openApp('google')" ontouchend="handleTouch(event,'google')"><div class="icon-img icon-google">🌐</div><span class="icon-label">Google</span></div>
        <div class="desktop-icon" ondblclick="openApp('erik')" ontouchend="handleTouch(event,'erik')"><div class="icon-img icon-erik">🧠</div><span class="icon-label">Erika</span></div>
        <div class="desktop-icon" ondblclick="openApp('admin')" ontouchend="handleTouch(event,'admin')"><div class="icon-img icon-admin">⚙️</div><span class="icon-label">Admin</span></div>
    </div>

    <div id="windowsContainer"></div>
    <div class="taskbar hidden" id="taskbar"></div>

    <script src="/static/js/boot.js"></script>
    <script src="/static/js/context-menu.js"></script>

<script>
// ====== WINDOW MANAGER ======
let zIndexCounter=100,windows={},touchTimer=null,windowStates={},windowPositions={};
const windowIcons={paint:'🎨',video:'🎬',gallery:'🖼️',google:'🌐',erik:'🧠',admin:'⚙️'};
function clamp(v,min,max){return Math.max(min,Math.min(max,v))}
function handleTouch(e,app){if(touchTimer){clearTimeout(touchTimer);touchTimer=null;openApp(app)}else{touchTimer=setTimeout(()=>{touchTimer=null},300)}}
function createWindow(id,title,html,w=400,h=480){
    if(windows[id]){if(windowStates[id]==='minimized'){windowStates[id]='normal';windows[id].classList.remove('minimized')}focusWindow(id);updateTaskbar();return windows[id]}
    const win=document.createElement('div');win.className='window';win.id='window-'+id;
    const left=clamp(25+Object.keys(windows).length*25,0,window.innerWidth-w),top=clamp(50+Object.keys(windows).length*30,0,window.innerHeight-h-65);
    win.style.width=w+'px';win.style.height=h+'px';win.style.left=left+'px';win.style.top=top+'px';win.style.zIndex=++zIndexCounter;
    win.innerHTML=`<div class="window-titlebar" id="titlebar-${id}"><div class="win-controls"><button class="win-btn btn-close"></button><button class="win-btn btn-min"></button><button class="win-btn btn-max"></button></div><span class="window-title">${title}</span></div><div class="window-body" id="body-${id}">${html}</div>`;
    win.querySelector('.btn-close').addEventListener('click',e=>{e.stopPropagation();closeWindow(id)});
    win.querySelector('.btn-min').addEventListener('click',e=>{e.stopPropagation();minimizeWindow(id)});
    win.querySelector('.btn-max').addEventListener('click',e=>{e.stopPropagation();toggleMaximize(id)});
    document.getElementById('windowsContainer').appendChild(win);
    windows[id]=win;windowStates[id]='normal';windowPositions[id]={left,top,width:w,height:h};
    makeDraggable(id);win.addEventListener('pointerdown',()=>focusWindow(id));updateTaskbar();return win;
}
function focusWindow(id){if(!windows[id])return;windows[id].style.zIndex=++zIndexCounter;Object.keys(windows).forEach(w=>{if(w!==id&&windows[w])windows[w].style.opacity='0.85'});updateTaskbar()}
function closeWindow(id){if(!windows[id])return;windows[id].style.animation='winOpen 0.2s ease reverse';setTimeout(()=>{windows[id].remove();delete windows[id];delete windowStates[id];delete windowPositions[id];updateTaskbar()},200)}
function minimizeWindow(id){if(!windows[id])return;windowStates[id]='minimized';windows[id].classList.add('minimized');windows[id].classList.remove('maximized');updateTaskbar()}
function toggleMaximize(id){if(!windows[id])return;if(windowStates[id]==='maximized'){windowStates[id]='normal';windows[id].classList.remove('maximized');const p=windowPositions[id];if(p){windows[id].style.left=p.left+'px';windows[id].style.top=p.top+'px';windows[id].style.width=p.width+'px';windows[id].style.height=p.height+'px'}}else{windowPositions[id]={left:windows[id].offsetLeft,top:windows[id].offsetTop,width:windows[id].offsetWidth,height:windows[id].offsetHeight};windowStates[id]='maximized';windows[id].classList.remove('minimized');windows[id].classList.add('maximized')}updateTaskbar()}
function updateTaskbar(){const tb=document.getElementById('taskbar'),apps=Object.keys(windows);if(apps.length===0){tb.classList.add('hidden');return}tb.classList.remove('hidden');let h='';apps.forEach(id=>{const s=windowStates[id],icon=windowIcons[id]||'📦',title=windows[id].querySelector('.window-title').textContent,c=s==='minimized'?'minimized':'active';h+=`<div class="taskbar-item ${c}" onclick="restoreOrFocusWindow('${id}')"><span>${icon}</span><span>${title}</span></div>`});tb.innerHTML=h}
function restoreOrFocusWindow(id){if(!windows[id])return;if(windowStates[id]==='minimized'){windowStates[id]='normal';windows[id].classList.remove('minimized')}focusWindow(id);updateTaskbar()}
function makeDraggable(id){const win=windows[id];if(!win)return;const tb=document.getElementById('titlebar-'+id);let isDragging=false,sX,sY,iX,iY;function onStart(e){if(windowStates[id]==='maximized'||windowStates[id]==='minimized')return;if(e.target.tagName==='BUTTON')return;isDragging=true;const p=e.touches?e.touches[0]:e;sX=p.clientX;sY=p.clientY;iX=win.offsetLeft;iY=win.offsetTop;win.style.transition='none';focusWindow(id)}function onMove(e){if(!isDragging)return;e.preventDefault();const p=e.touches?e.touches[0]:e;win.style.left=clamp(iX+(p.clientX-sX),-(win.offsetWidth-80),window.innerWidth-80)+'px';win.style.top=clamp(iY+(p.clientY-sY),0,window.innerHeight-65)+'px'}function onEnd(){if(!isDragging)return;isDragging=false;win.style.transition='';if(windowPositions[id]&&windowStates[id]==='normal'){windowPositions[id].left=win.offsetLeft;windowPositions[id].top=win.offsetTop}}tb.addEventListener('pointerdown',onStart);tb.addEventListener('touchstart',onStart,{passive:false});document.addEventListener('pointermove',onMove);document.addEventListener('touchmove',onMove,{passive:false});document.addEventListener('pointerup',onEnd);document.addEventListener('touchend',onEnd)}

function openApp(t){
    switch(t){
        case'paint':openPaint();break;
        case'video':openVideo();break;
        case'gallery':openGallery();break;
        case'google':openGoogle();break;
        case'erik':openErik();break;
        case'admin':openAdmin();break;
    }
}

// ====== PAINT ======
function openPaint(){
    createWindow('paint','PAINT.EXE',`<div style="display:flex;flex-direction:column;height:100%"><div style="display:flex;gap:8px;padding:8px 12px;background:rgba(8,8,24,0.8);flex-wrap:wrap"><input type="color" id="pc" value="#ffffff" style="width:34px;height:34px;background:transparent;border:1px solid var(--border-glow);cursor:pointer"><input type="range" id="ps" min="1" max="35" value="6" style="width:60px;accent-color:var(--neon-purple)"><button id="bc" class="btn btn--small btn--danger">CLEAR</button><button id="bs" class="btn btn--small btn--success">SAVE</button></div><div style="flex:1;background:#000"><canvas id="paintCanvas" style="display:block;cursor:crosshair;touch-action:none;width:100%;height:100%"></canvas></div></div>`,390,480);
    setTimeout(()=>{
        const c=document.getElementById('paintCanvas');if(!c||c.dataset.init)return;c.dataset.init='1';
        const ctx=c.getContext('2d'),wrap=c.parentElement;
        function resize(){const img=ctx.getImageData(0,0,c.width,c.height);c.width=wrap.clientWidth;c.height=wrap.clientHeight;ctx.putImageData(img,0,0)}
        resize();new ResizeObserver(resize).observe(wrap);
        let drawing=false;const color=document.getElementById('pc'),size=document.getElementById('ps');
        function pos(e){const r=c.getBoundingClientRect(),p=e.touches?e.touches[0]:e;return{x:p.clientX-r.left,y:p.clientY-r.top}}
        c.addEventListener('pointerdown',e=>{e.preventDefault();drawing=true;const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y)});
        c.addEventListener('touchstart',e=>{e.preventDefault();drawing=true;const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y)},{passive:false});
        c.addEventListener('pointermove',e=>{if(!drawing)return;e.preventDefault();const p=pos(e);ctx.lineWidth=+size.value;ctx.lineCap='round';ctx.strokeStyle=color.value;ctx.lineTo(p.x,p.y);ctx.stroke();ctx.beginPath();ctx.moveTo(p.x,p.y)});
        c.addEventListener('touchmove',e=>{if(!drawing)return;e.preventDefault();const p=pos(e);ctx.lineWidth=+size.value;ctx.lineCap='round';ctx.strokeStyle=color.value;ctx.lineTo(p.x,p.y);ctx.stroke();ctx.beginPath();ctx.moveTo(p.x,p.y)},{passive:false});
        c.addEventListener('pointerup',()=>{drawing=false});c.addEventListener('pointerleave',()=>{drawing=false});c.addEventListener('touchend',()=>{drawing=false});
        document.getElementById('bc').addEventListener('click',()=>{ctx.clearRect(0,0,c.width,c.height)});
        document.getElementById('bs').addEventListener('click',()=>{
            const d=c.toDataURL('image/png');
            let g=JSON.parse(localStorage.getItem('pixelGallery')||'[]');
            g.unshift({type:'image',data:d,time:new Date().toLocaleString()});
            if(g.length>50)g=g.slice(0,50);
            localStorage.setItem('pixelGallery',JSON.stringify(g));
            showToast('SAVED');
            // Обновить галерею если открыта
            if(windows['gallery']){closeWindow('gallery');openGallery();}
        });
    },350);
}

// ====== GALLERY (С КНОПКОЙ УДАЛЕНИЯ) ======
function openGallery(){
    let g=JSON.parse(localStorage.getItem('pixelGallery')||'[]');
    let items='';
    if(g.length===0){
        items='<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-dim);flex-direction:column;gap:8px"><span style="font-size:40px">🖼️</span><span>GALLERY EMPTY</span></div>';
    } else {
        items='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:4px;padding:8px">';
        g.forEach((img,i)=>{
            items+=`<div id="gal-item-${i}" style="position:relative;aspect-ratio:1;background:#000;border:1px solid var(--border-subtle);overflow:hidden">
                <img src="${img.data}" style="width:100%;height:100%;object-fit:contain;cursor:pointer" onclick="viewFullImage(${i})" loading="lazy">
                <button class="gallery-delete-btn" onclick="event.stopPropagation();deleteImage(${i})" title="Удалить">✕</button>
            </div>`;
        });
        items+='</div>';
    }
    createWindow('gallery','GALLERY.exe',items,400,400);
}

// ====== ФУНКЦИИ УДАЛЕНИЯ ======
function deleteImage(index){
    if(!confirm('Удалить эту картинку?')) return;
    let g=JSON.parse(localStorage.getItem('pixelGallery')||'[]');
    if(index>=0 && index<g.length){
        g.splice(index,1);
        localStorage.setItem('pixelGallery',JSON.stringify(g));
        // Анимация
        const el=document.getElementById('gal-item-'+index);
        if(el){el.style.opacity='0';el.style.transform='scale(0.8)';el.style.transition='all 0.3s ease'}
        setTimeout(()=>{closeWindow('gallery');openGallery();},300);
        showToast('🗑️ Удалено');
    }
}

function viewFullImage(index){
    let g=JSON.parse(localStorage.getItem('pixelGallery')||'[]');
    if(!g[index]) return;
    let ov=document.createElement('div');
    ov.style.cssText='position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.95);display:flex;align-items:center;justify-content:center;cursor:pointer';
    let img=document.createElement('img');
    img.src=g[index].data;
    img.style.cssText='max-width:95vw;max-height:95vh;object-fit:contain;border:1px solid var(--border-glow)';
    ov.appendChild(img);
    ov.addEventListener('click',()=>ov.remove());
    document.body.appendChild(ov);
}

// ====== VIDEO ======
function openVideo(){createWindow('video','VIDEO_EDIT.exe','<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-dim);font-family:var(--font-mono)">🎬 ERIKA_ENGINE</div>',400,350)}

// ====== GOOGLE ======
function openGoogle(){createWindow('google','WEB.exe','<iframe src="https://www.google.com/webhp?igu=1" style="width:100%;height:100%;border:none"></iframe>',420,520)}

// ====== ERIK ======
function openErik(){createWindow('erik','ERIKA_CHAT.exe','<iframe src="/erik" style="width:100%;height:100%;border:none"></iframe>',420,520)}

// ====== ADMIN ======
function openAdmin(){
    createWindow('admin','ADMIN.exe','<div style="padding:14px;overflow:auto;height:100%;font-family:var(--font-mono);font-size:11px" id="adminContent">LOADING...</div>',460,420);
    fetch('/api/logs').then(r=>r.json()).then(d=>{
        let h='<table class="table-cyber"><thead><tr><th>IP</th><th>TIME</th><th>STATUS</th></tr></thead><tbody>';
        d.logs.forEach(l=>{h+=`<tr><td class="ip-cell">${l.ip}</td><td class="time-cell">${l.time}</td><td class="status-${l.status}">${l.status==='success'?'✓ GRANTED':'✗ DENIED'}</td></tr>`});
        h+='</tbody></table>';
        document.getElementById('adminContent').innerHTML=h;
    });
}

function showToast(msg){
    const e=document.querySelector('.toast');if(e)e.remove();
    const t=document.createElement('div');t.className='toast';t.textContent=msg;
    document.body.appendChild(t);
    setTimeout(()=>{t.style.opacity='0';t.style.transition='opacity 0.3s'},1800);
    setTimeout(()=>t.remove(),2200);
}
</script>
</body>
</html>
